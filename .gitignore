# Python caches / bytecode
__pycache__/
*.py[cod]
*$py.class

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
.coverage.*
htmlcov/

# Virtual envs
.venv/
.venv_build/
venv/

# Local runtime artifacts
run_logs/
exports/
releases/
dist/
build/
.pycache_local/
*.log
*.zip
*.bak*

# Build artifacts
OFFLINE/dist/

# Local notebooks (temporary/scratch)
*.ipynb

# Local OS/editor files
.DS_Store
.idea/
.vscode/

# Python tooling caches that aren't already covered above
.pre-commit-trash/
*.egg-info/

# Prevent accidental tracking of patient data exports
exports/**/*
!exports/.gitkeep
